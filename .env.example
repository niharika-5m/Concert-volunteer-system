# Copy to .env.local and fill in. Never commit .env.local.

# --- MySQL (mandatory) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=concert_deployment_db

# --- Session signing key (32+ random characters) ---
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# --- MongoDB (optional: powers the Activity feed) ---
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=concert_deployment_logs
MONGODB_COLLECTION=activity_logs

# --- Behaviour ---
# true = staff can only check in from 60 min before the shift until it ends.
ENFORCE_CHECKIN_WINDOW=false

# --- Only if your API lives on a different origin than Next.js ---
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
